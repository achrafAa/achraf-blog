<style>
  :root {
    --color-cyber: #C4A57B;
    --color-cyber-bright: #D2B48C;
    --font-display: 'Work Sans', system-ui, sans-serif;
    --font-body: 'IBM Plex Sans', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Selection styling */
  ::selection {
    background-color: var(--color-cyber);
    color: #000000;
  }

  .page-container {
    min-height: 100vh;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  /* Grid background */
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 50px, #000000 50px, #000000 51px),
      repeating-linear-gradient(90deg, transparent, transparent 50px, #000000 50px, #000000 51px);
    opacity: 0.03;
  }

  /* Cyber glows */
  .cyber-glow {
    position: absolute;
    background: var(--color-cyber);
    opacity: 0.08;
    blur: 100px;
    border-radius: 50%;
    animation: float 20s ease-in-out infinite;
  }

  .cyber-glow-1 {
    width: 500px;
    height: 500px;
    top: -200px;
    right: -200px;
  }

  .cyber-glow-2 {
    width: 400px;
    height: 400px;
    bottom: -150px;
    left: -150px;
    animation-delay: -10s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(30px, -30px);
    }
  }

  /* Card wrapper */
  .card-wrapper {
    position: relative;
    max-width: 540px;
    width: 100%;
    animation: cardEntrance 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cardEntrance {
    from {
      opacity: 0;
      transform: translateY(50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .business-card {
    background: #FFFFFF;
    border: 5px solid #5A5048;
    padding: 0;
    position: relative;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .business-card:hover {
    transform: translate(4px, -4px);
    box-shadow: -8px 8px 0px 0px var(--color-cyber);
  }

  /* Top/bottom bars */
  .top-bar,
  .bottom-bar {
    height: 5px;
    background: var(--color-cyber);
  }

  /* Profile section */
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 3rem 2.5rem 2rem;
  }

  .image-container {
    position: relative;
  }

  .image-frame {
    position: relative;
    width: 160px;
    height: 160px;
    border: 5px solid #5A5048;
    background: var(--color-cyber);
    animation: imageReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
    transition: all 0.3s ease;
  }

  .image-frame:hover {
    transform: translate(3px, -3px);
    box-shadow: -6px 6px 0px 0px var(--color-cyber);
  }

  @keyframes imageReveal {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Name block */
  .name-block {
    text-align: center;
  }

  .name {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 900;
    color: #000000;
    line-height: 1;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }

  .title-wrapper {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }

  .title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: #000000;
    letter-spacing: 0.1em;
    display: block;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Status section */
  .status-section {
    padding: 0 2.5rem 2rem;
    display: flex;
    justify-content: center;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-cyber);
    border: 3px solid #5A5048;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background: #000000;
    border-radius: 50%;
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .status-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: #000000;
    letter-spacing: 0.1em;
  }

  /* Links section */
  .links-section {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 3px solid #5A5048;
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 2rem;
    text-decoration: none;
    color: #000000;
    background: #FFFFFF;
    border-bottom: 3px solid #5A5048;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.2s ease;
    position: relative;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .link-item:nth-child(1) { animation-delay: 0.8s; }
  .link-item:nth-child(2) { animation-delay: 0.9s; }
  .link-item:nth-child(3) { animation-delay: 1s; }

  .link-item:last-child {
    border-bottom: none;
  }

  .link-item:hover {
    background: var(--color-cyber);
    padding-left: 2.5rem;
  }

  .link-item:active {
    transform: translateY(2px);
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #000000;
    transition: transform 0.2s ease;
  }

  .link-item:hover .link-icon {
    transform: scale(1.15);
  }

  .link-icon svg {
    width: 100%;
    height: 100%;
  }

  .link-label {
    flex: 1;
    letter-spacing: 0.05em;
  }

  .link-arrow {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: #000000;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.2s ease;
  }

  .link-item:hover .link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .page-container {
      padding: 1.5rem;
    }

    .profile-section {
      padding: 2.5rem 2rem 1.5rem;
    }

    .name {
      font-size: 2.25rem;
    }

    .title {
      font-size: 0.7rem;
    }

    .image-frame {
      width: 140px;
      height: 140px;
    }

    .link-item {
      padding: 1rem 1.5rem;
      font-size: 0.9rem;
    }

    .link-item:hover {
      padding-left: 2rem;
    }

    .status-section {
      padding: 0 2rem 1.5rem;
    }
  }
</style>
